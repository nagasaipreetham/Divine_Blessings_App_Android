<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_rounded">

    <!-- Header with title and reset button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Adjust Speed"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <Button
            android:id="@+id/btnResetSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textSize="14sp"
            android:background="@drawable/bg_button_primary"
            android:textColor="?attr/colorOnPrimary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="16dp" />

    <!-- Speed display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnSpeedMinus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_accent_round"
            android:src="@drawable/ic_minus_24"
            android:contentDescription="Decrease speed" />

        <TextView
            android:id="@+id/txtSpeedValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="?attr/colorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSpeedPlus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_accent_round"
            android:contentDescription="Increase speed"
            android:src="@drawable/ic_plus_24" />
    </LinearLayout>


    <Space
        android:layout_width="0dp"
        android:layout_height="16dp" />

    <!-- Speed control slider -->
    <SeekBar
        android:id="@+id/seekBarSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="7"
        android:progress="3" />


</LinearLayout>
